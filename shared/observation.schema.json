{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kohlerfryer/puddles/shared/observation.schema.json",
  "title": "Observation",
  "description": "The snapshot brains read: what Puddles senses this tick. Summaries only, never raw media.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kid", "smile", "world", "self"],
  "properties": {
    "kid": { "$ref": "#/$defs/Kid" },
    "held_object": { "$ref": "#/$defs/HeldObject" },
    "smile": { "$ref": "#/$defs/Smile" },
    "laugh": { "type": "boolean" },
    "speech": { "$ref": "#/$defs/Speech" },
    "world": { "$ref": "#/$defs/WorldView" },
    "self": { "$ref": "#/$defs/SelfState" }
  },
  "$defs": {
    "Kid": {
      "title": "Kid",
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "attention", "distance"],
      "properties": {
        "present": { "type": "boolean" },
        "pose": { "$ref": "#/$defs/Pose" },
        "gesture": { "type": "string", "minLength": 1 },
        "attention": { "type": "number", "minimum": 0, "maximum": 1 },
        "distance": { "type": "number", "minimum": 0, "description": "Metres from the camera." }
      }
    },
    "Pose": {
      "title": "Pose",
      "description": "Where the kid is in the window, 0 to 1 from the left and the top.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "HeldObject": {
      "title": "HeldObject",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "A prop id, or other." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "Smile": {
      "title": "Smile",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "delta"],
      "properties": {
        "level": { "type": "number", "minimum": 0, "maximum": 1 },
        "delta": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "Speech": {
      "title": "Speech",
      "type": "object",
      "additionalProperties": false,
      "required": ["active"],
      "properties": {
        "active": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "WorldView": {
      "title": "WorldView",
      "type": "object",
      "additionalProperties": false,
      "required": ["near"],
      "properties": {
        "near": { "type": "array", "items": { "$ref": "#/$defs/Entity" } }
      }
    },
    "Entity": {
      "title": "Entity",
      "description": "Something in the world near Puddles, and what he can do with it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "affords"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "affords": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "SelfState": {
      "title": "SelfState",
      "type": "object",
      "additionalProperties": false,
      "required": ["mood", "needs", "doing"],
      "properties": {
        "mood": { "$ref": "reaction.schema.json#/$defs/Mood" },
        "needs": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": "Each need from 0 (met) to 1 (urgent)."
        },
        "doing": {
          "type": "string",
          "minLength": 1,
          "description": "The skill or behavior running, or idle."
        }
      }
    }
  }
}
