{
  "name": "puddles-game",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "deadcode": "knip",
    "gen:types": "json2ts --maxItems -1 -i ../shared/reaction.schema.json -o src/core/reaction.ts --bannerComment \"// Generated from shared/reaction.schema.json by pnpm gen:types. Do not edit.\" && prettier --write src/core/reaction.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/matter-js": "^0.20.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.3",
    "json-schema-to-typescript": "^16.0.0",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "ajv": "^8.20.0",
    "ldtk": "^0.8.7",
    "matter-js": "^0.20.0",
    "miniplex": "^2.0.0",
    "pixi.js": "^8.23.0"
  }
}
